{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard"}]},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [{"title": "Production alert runbooks", "type": "link", "url": "https://github.com/agenticrag/agenticrag/blob/main/deploy/monitoring/runbooks/agenticrag-alerts.md", "targetBlank": true}],
  "panels": [
    {
      "id": 1, "title": "Turn command availability (30d)", "type": "stat", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(increase(agenticrag_sli_events_total{sli=\"turn_command\",classification=\"good\",region=~\"$region\"}[30d])) / clamp_min(sum(increase(agenticrag_sli_events_total{sli=\"turn_command\",classification=~\"good|bad\",region=~\"$region\"}[30d])), 1)", "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 0.9995}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2, "title": "Active P0 pages", "type": "stat", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(ALERTS{service=\"agenticrag\",priority=\"p0\",alertstate=\"firing\"})", "legendFormat": "pages"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3, "title": "Queue backlog", "type": "stat", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(agenticrag_run_queue_messages{status=~\"READY|LEASED\",region=~\"$region\"})", "legendFormat": "pending"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3000}, {"color": "red", "value": 5000}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4, "title": "Estimated LLM cost / hour", "type": "stat", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(increase(agenticrag_llm_cost_nanos_total{plan=~\"$plan\",provider=~\"$provider\",region=~\"$region\"}[1h])) / 1e9", "legendFormat": "currency/hour"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5, "title": "Request rate by status class", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (status_class) (rate(agenticrag_http_requests_total{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval]))", "legendFormat": "{{status_class}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5}
    },
    {
      "id": 6, "title": "HTTP latency p50 / p95 / p99", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(agenticrag_http_request_duration_seconds_bucket{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(agenticrag_http_request_duration_seconds_bucket{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(agenticrag_http_request_duration_seconds_bucket{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5}
    },
    {
      "id": 7, "title": "Queue wait p95 and active Runs", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agenticrag_run_queue_wait_seconds_bucket{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "queue wait p95"},
        {"refId": "B", "expr": "sum(agenticrag_worker_active_runs{plan=~\"$plan\",region=~\"$region\"})", "legendFormat": "active Runs"}
      ],
      "fieldConfig": {"defaults": {}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5}
    },
    {
      "id": 8, "title": "Run terminal outcomes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(agenticrag_runs_total{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval]))", "legendFormat": "{{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13}
    },
    {
      "id": 9, "title": "Run duration p95 / p99", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agenticrag_run_duration_seconds_bucket{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "p95"},
        {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(agenticrag_run_duration_seconds_bucket{plan=~\"$plan\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13}
    },
    {
      "id": 10, "title": "Retrieval logical availability", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(rate(agenticrag_sli_events_total{sli=\"retrieval\",classification=\"good\",region=~\"$region\"}[$__rate_interval])) / clamp_min(sum(rate(agenticrag_sli_events_total{sli=\"retrieval\",classification=~\"good|bad\",region=~\"$region\"}[$__rate_interval])), 0.001)", "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13}
    },
    {
      "id": 11, "title": "LLM outcomes by provider", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (provider,outcome) (rate(agenticrag_llm_requests_total{plan=~\"$plan\",provider=~\"$provider\",region=~\"$region\"}[$__rate_interval]))", "legendFormat": "{{provider}} {{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21}
    },
    {
      "id": 12, "title": "LLM TTFT p95", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le,provider) (rate(agenticrag_llm_ttft_seconds_bucket{plan=~\"$plan\",provider=~\"$provider\",region=~\"$region\"}[$__rate_interval])))", "legendFormat": "{{provider}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 21}
    },
    {
      "id": 13, "title": "Dependency health", "type": "state-timeline", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "up{job=~\"agenticrag-postgres|agenticrag-redis\",region=~\"$region\"}", "legendFormat": "{{job}}"},
        {"refId": "B", "expr": "probe_success{job=~\"agenticrag-object-storage|agenticrag-search-index\",region=~\"$region\"}", "legendFormat": "{{job}}"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 21}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["agenticrag", "operations", "slo"],
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1},
    {"name": "region", "label": "Region", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(agenticrag_http_requests_total, region)"}, "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2},
    {"name": "plan", "label": "Plan", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(agenticrag_http_requests_total, plan)"}, "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2},
    {"name": "provider", "label": "Provider", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(agenticrag_llm_requests_total, provider)"}, "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2}
  ]},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "utc",
  "title": "AgenticRAG Operations",
  "uid": "agenticrag-operations",
  "version": 1
}
